{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profile document containing basic account info",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "description": "Unique user ID" },
        "email": { "type": "string", "description": "User email address" },
        "displayName": { "type": "string", "description": "User display name" },
        "photoURL": { "type": "string", "description": "Profile picture URL" },
        "createdAt": { "type": "string", "description": "Account creation timestamp" }
      },
      "required": ["uid", "createdAt"]
    },
    "Note": {
      "title": "Note",
      "description": "User note item",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Unique note ID" },
        "userId": { "type": "string", "description": "Owner user ID" },
        "title": { "type": "string", "description": "Note title" },
        "content": { "type": "string", "description": "Note markdown or text content" },
        "folderId": { "type": "string", "description": "Optional assigned folder ID" },
        "createdAt": { "type": "string", "description": "Creation timestamp" },
        "updatedAt": { "type": "string", "description": "Last updated timestamp" }
      },
      "required": ["id", "userId", "title", "content", "createdAt"]
    },
    "ChatSession": {
      "title": "ChatSession",
      "description": "User AI chat session / thread",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Unique session ID" },
        "userId": { "type": "string", "description": "Owner user ID" },
        "title": { "type": "string", "description": "Session title" },
        "personaId": { "type": "string", "description": "Selected AI Persona ID" },
        "folderId": { "type": "string", "description": "Optional assigned folder ID" },
        "messages": { "type": "array", "description": "Array of chat messages" },
        "createdAt": { "type": "string", "description": "Creation timestamp" },
        "updatedAt": { "type": "string", "description": "Last update timestamp" }
      },
      "required": ["id", "userId", "title", "personaId", "messages", "createdAt", "updatedAt"]
    },
    "Folder": {
      "title": "Folder",
      "description": "User organizing folder",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Unique folder ID" },
        "userId": { "type": "string", "description": "Owner user ID" },
        "name": { "type": "string", "description": "Folder display name" },
        "color": { "type": "string", "description": "Folder color accent tag" },
        "targetType": { "type": "string", "description": "Folder target type (notes | chat)" },
        "createdAt": { "type": "string", "description": "Creation timestamp" },
        "updatedAt": { "type": "string", "description": "Last update timestamp" }
      },
      "required": ["id", "userId", "name", "createdAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "User profile document"
    },
    "/users/{userId}/notes/{noteId}": {
      "schema": "Note",
      "description": "User notes collection"
    },
    "/users/{userId}/chatSessions/{sessionId}": {
      "schema": "ChatSession",
      "description": "User chat sessions collection"
    },
    "/users/{userId}/folders/{folderId}": {
      "schema": "Folder",
      "description": "User folders collection"
    }
  }
}
